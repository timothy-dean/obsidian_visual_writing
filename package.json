{
	"name": "visual-writing",
	"version": "1.0.0",
	"description": "Non-linear, visual writing and structural card rearrangement stored in plain Markdown files using hidden comments.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"visual-writing",
		"outliner",
		"cards"
	],
	"author": "Tim Dean",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "^0.20.0",
		"obsidian": "^1.5.0",
		"tslib": "^2.6.2",
		"typescript": "^5.3.3"
	}
}
